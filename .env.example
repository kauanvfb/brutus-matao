# Banco PostgreSQL da instância Supabase de desenvolvimento; SSL habilitado no provedor.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Usada apenas no servidor para publicar imagens autorizadas no Storage.
SUPABASE_SERVICE_ROLE_KEY=
# Origem canônica HTTPS para retorno do Checkout Pro; localhost só para desenvolvimento.
APP_URL=http://localhost:3000
# Só após revisão de fotos, conteúdo e operação pela Brutus.
SITE_APPROVED=false
# Gere um segredo aleatório com 32+ bytes; mantenha estável para permitir reenvios idempotentes.
TRACKING_SECRET=
# disabled | test | live. O modo live também exige ENABLE_LIVE_PAYMENTS=true.
PAYMENT_MODE=disabled
ENABLE_LIVE_PAYMENTS=false
MP_TEST_ACCESS_TOKEN=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
